{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": ["**/*.prisma"]
  },
  "watchOptions": {
    "watch": true,
    "watchAssets": true,
    "watchIgnore": ["node_modules", "dist", ".git"]
  }
}

